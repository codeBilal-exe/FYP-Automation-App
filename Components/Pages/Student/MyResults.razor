@page "/student/results"
@attribute [Authorize(Roles = "Student")]
@inject AppDbContext Db
@inject EvaluationService EvaluationService
@using Microsoft.EntityFrameworkCore

<div class="page-header"><div><h1>My Results</h1><div class="page-subtitle">Final evaluation and rubric breakdown.</div></div></div>

@if (_loading) { <LoadingSpinner /> }
else if (_evaluation == null) { <div class="empty-state"><i class="bi bi-hourglass-split"></i>No evaluation results yet. Results appear after the panel locks the evaluation.</div> }
else
{
  <div class="row g-3">
    <div class="col-md-4">
      <div class="fcard text-center">
        <div class="text-muted small text-uppercase">Total Score</div>
        <div style="font-size:3rem;font-weight:800;color:var(--primary-700)">@_evaluation.TotalScore</div>
        <div class="text-muted small">/ @_max</div>
        <div class="mt-2"><span class="fbadge completed">Locked</span></div>
      </div>
    </div>
    <div class="col-md-8">
      <div class="fcard">
        <div class="fcard-title"><i class="bi bi-list-check"></i> Rubric Breakdown</div>
        <table class="ftable">
          <thead><tr><th>Criterion</th><th>Marks</th><th>Max</th></tr></thead>
          <tbody>
            @foreach (var s in _evaluation.RubricScores)
            {
              <tr><td>@s.RubricItem?.Criterion</td><td><strong>@s.ObtainedMarks</strong></td><td>@s.RubricItem?.MaxMarks</td></tr>
            }
          </tbody>
        </table>
        @if (!string.IsNullOrEmpty(_evaluation.Feedback))
        {
          <div class="mt-3"><h6>Feedback</h6><div class="text-muted">@_evaluation.Feedback</div></div>
        }
      </div>
    </div>
  </div>
}

@code {
  private bool _loading = true;
  private Evaluation? _evaluation;
  private decimal _max;

  protected override async Task OnInitializedAsync()
  {
    var u = AuthService.CurrentUser; if (u == null) return;
    var g = await Db.Groups.Include(g => g.Members).Include(g => g.Project).FirstOrDefaultAsync(g => g.Members.Any(m => m.Id == u.Id));
    if (g?.Project != null)
    {
      _evaluation = await Db.Evaluations
        .Include(e => e.RubricScores).ThenInclude(rs => rs.RubricItem)
        .Where(e => e.ProjectId == g.Project.Id && e.IsLocked)
        .OrderByDescending(e => e.EvaluatedAt)
        .FirstOrDefaultAsync();
      _max = await Db.RubricItems.SumAsync(r => r.MaxMarks);
    }
    _loading = false;
  }
}
