@page "/supervisor/proposals"
@page "/admin/proposals"
@attribute [Authorize(Roles = "Supervisor,Coordinator,HOD,Admin")]
@inject ProposalService ProposalService
@inject AuditService AuditService
@inject AppDbContext Db
@using Microsoft.EntityFrameworkCore

<div class="page-header"><div><h1>Review Proposals</h1><div class="page-subtitle">Approve or reject pending proposals.</div></div></div>

<div class="fcard">
  @if (!_proposals.Any()) { <div class="empty-state"><i class="bi bi-clipboard"></i>No proposals to review.</div> }
  else
  {
    <table class="ftable">
      <thead><tr><th>Title</th><th>Student</th><th>Status</th><th>Submitted</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        @foreach (var p in _proposals)
        {
          var sName = _students.GetValueOrDefault(p.StudentId, "—");
          <tr>
            <td>
              <div class="fw-semibold">@p.Title</div>
              <div class="small text-muted">@(p.Abstract.Length > 100 ? p.Abstract.Substring(0,100) + "…" : p.Abstract)</div>
            </td>
            <td>@sName</td>
            <td><span class="fbadge @(p.Status == ProposalStatus.Rejected ? "danger" : "active")">@p.Status</span></td>
            <td>@p.SubmittedAt.ToString("MMM dd, yyyy")</td>
            <td class="text-end">
              <button class="btn btn-sm btn-success me-1" @onclick="() => Approve(p)"><i class="bi bi-check-lg"></i></button>
              <button class="btn btn-sm btn-outline-danger" @onclick="() => StartReject(p)"><i class="bi bi-x-lg"></i></button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>

@if (_rejecting != null)
{
  <div class="modal-backdrop-c" @onclick="() => _rejecting = null">
    <div class="modal-card" @onclick:stopPropagation>
      <h5 class="mb-2">Reject Proposal</h5>
      <p class="text-muted small">Provide a reason for rejection.</p>
      <textarea class="form-control mb-3" rows="3" @bind="_reason"></textarea>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-light" @onclick="() => _rejecting = null">Cancel</button>
        <button class="btn btn-danger" @onclick="ConfirmReject">Reject</button>
      </div>
    </div>
  </div>
}

@code {
  private List<Proposal> _proposals = new();
  private Dictionary<int,string> _students = new();
  private Proposal? _rejecting;
  private string _reason = "";
  private string _role = "";

  protected override async Task OnInitializedAsync()
  {
    var u = AuthService.CurrentUser; if (u == null) return;
    _role = u.Role.ToString();
    var pending = u.Role switch
    {
      UserRole.Supervisor   => await ProposalService.GetProposalsByStatusAsync(ProposalStatus.SubmittedToSupervisor),
      UserRole.Coordinator  => await ProposalService.GetProposalsByStatusAsync(ProposalStatus.ApprovedBySupervisor),
      UserRole.HOD          => await ProposalService.GetProposalsByStatusAsync(ProposalStatus.ApprovedByCoordinator),
      _                     => await ProposalService.GetAllProposalsAsync()
    };
    _proposals = pending;
    var ids = _proposals.Select(p => p.StudentId).Distinct().ToList();
    _students = await Db.Users.Where(x => ids.Contains(x.Id)).ToDictionaryAsync(x => x.Id, x => x.FullName);
  }

  private async Task Approve(Proposal p)
  {
    var u = AuthService.CurrentUser; if (u == null) return;
    var next = u.Role switch
    {
      UserRole.Supervisor  => ProposalStatus.ApprovedBySupervisor,
      UserRole.Coordinator => ProposalStatus.ApprovedByCoordinator,
      UserRole.HOD         => ProposalStatus.ApprovedByHOD,
      _                    => ProposalStatus.ApprovedByHOD
    };
    await ProposalService.UpdateProposalStatusAsync(p.Id, next);
    await AuditService.LogActionAsync(u.Id, "ProposalApprove", $"Proposal#{p.Id} -> {next}");
    await OnInitializedAsync();
  }

  private void StartReject(Proposal p) { _rejecting = p; _reason = ""; }

  private async Task ConfirmReject()
  {
    if (_rejecting == null) return;
    var u = AuthService.CurrentUser; if (u == null) return;
    await ProposalService.UpdateProposalStatusAsync(_rejecting.Id, ProposalStatus.Rejected, _reason);
    await AuditService.LogActionAsync(u.Id, "ProposalReject", $"Proposal#{_rejecting.Id}: {_reason}");
    _rejecting = null;
    await OnInitializedAsync();
  }
}
