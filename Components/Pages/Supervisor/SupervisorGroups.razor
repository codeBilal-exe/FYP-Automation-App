@page "/supervisor/groups"
@attribute [Authorize(Roles = "Supervisor")]
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider
@using Microsoft.EntityFrameworkCore

<div class="page-header"><div><h1>My Groups</h1><div class="page-subtitle">Groups assigned to you.</div></div></div>

@if (!_groups.Any()) { <div class="empty-state"><i class="bi bi-people"></i>No groups assigned.</div> }
else
{
  <div class="row g-3">
    @foreach (var item in _groups)
    {
      var g = item.Group;
      <div class="col-md-6">
        <div class="fcard lift">
          <div class="d-flex justify-content-between align-items-start">
            <div><strong>@g.GroupName</strong><div class="text-muted small">@(g.Project?.Title ?? "No project")</div></div>
            <span class="fbadge @(g.Project?.Status.ToString().ToLower() ?? "pending")">@(g.Project?.Status.ToString() ?? "-")</span>
          </div>
          <div class="mt-3">
            <div class="text-muted small text-uppercase mb-1">GitHub Repository</div>
            @if (!string.IsNullOrWhiteSpace(item.GitHubUrl))
            {
              <a href="@item.GitHubUrl" target="_blank" rel="noopener noreferrer">@item.GitHubUrl</a>
            }
            else
            {
              <div class="small text-muted">Not provided yet.</div>
            }
          </div>
          <hr/>
          <div class="text-muted small text-uppercase mb-2">Members</div>
          @foreach (var m in g.Members)
          {
            <div class="d-flex align-items-center gap-2 py-1">
              <div class="avatar" style="width:30px;height:30px;font-size:.7rem">@(string.IsNullOrEmpty(m.FullName)?"?":m.FullName[0].ToString())</div>
              <div class="small">@m.FullName <span class="text-muted">- @m.Email</span></div>
            </div>
          }
        </div>
      </div>
    }
  </div>
}

@code {
  private sealed class SupervisorGroupVm
  {
    public Group Group { get; set; } = new();
    public string? GitHubUrl { get; set; }
  }

  private List<SupervisorGroupVm> _groups = new();

  protected override async Task OnInitializedAsync()
  {
    var auth = await AuthProvider.GetAuthenticationStateAsync();
    var idValue = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    if (!int.TryParse(idValue, out var supervisorId) || supervisorId <= 0)
      return;

    var groups = await Db.Groups
      .AsNoTracking()
      .Include(g => g.Members)
      .Include(g => g.Project)
      .Where(g => g.SupervisorId == supervisorId)
      .ToListAsync();

    var groupIds = groups.Select(g => g.Id).ToList();
    var proposalLinks = await Db.Proposals
      .AsNoTracking()
      .Where(p => groupIds.Contains(p.GroupId) && !string.IsNullOrWhiteSpace(p.GitHubUrl))
      .Select(p => new { p.GroupId, p.GitHubUrl, p.UpdatedAt, p.SubmittedAt })
      .ToListAsync();

    var latestProposalLinkByGroup = proposalLinks
      .GroupBy(p => p.GroupId)
      .ToDictionary(
        g => g.Key,
        g => g
          .OrderByDescending(x => x.UpdatedAt)
          .ThenByDescending(x => x.SubmittedAt)
          .Select(x => NormalizeGitHubUrl(x.GitHubUrl))
          .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)));

    _groups = groups.Select(g =>
    {
      latestProposalLinkByGroup.TryGetValue(g.Id, out var proposalGitHub);
      var projectGitHub = NormalizeGitHubUrl(g.Project?.GitHubUrl);
      return new SupervisorGroupVm
      {
        Group = g,
        GitHubUrl = !string.IsNullOrWhiteSpace(proposalGitHub) ? proposalGitHub : projectGitHub
      };
    }).ToList();
  }

  private static string? NormalizeGitHubUrl(string? url)
  {
    if (string.IsNullOrWhiteSpace(url))
      return null;

    var value = url.Trim();
    if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
        value.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
      return value;

    if (value.Contains("github.com", StringComparison.OrdinalIgnoreCase))
      return $"https://{value.TrimStart('/')}";

    return $"https://github.com/{value.TrimStart('/')}";
  }
}
