@page "/admin/users"
@attribute [Authorize(Roles = "Admin,HOD")]
@inject UserService UserService
@inject AuditService AuditService

<div class="page-header">
  <div><h1>Manage Users</h1><div class="page-subtitle">Create, edit and deactivate user accounts.</div></div>
  <button class="btn btn-primary" @onclick="() => _showNew = true"><i class="bi bi-plus-lg me-1"></i>New User</button>
</div>

<div class="fcard">
  <table class="ftable">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
      @foreach (var u in _users)
      {
        <tr>
          <td><div class="d-flex align-items-center gap-2"><div class="avatar" style="width:32px;height:32px;font-size:.75rem">@u.FullName[0]</div>@u.FullName</div></td>
          <td>@u.Email</td>
          <td><span class="fbadge info">@u.Role</span></td>
          <td>@(u.IsActive ? "Yes" : "No")</td>
          <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => Deactivate(u)" disabled="@(!u.IsActive)"><i class="bi bi-trash"></i></button></td>
        </tr>
      }
    </tbody>
  </table>
</div>

@if (_showNew)
{
  <div class="modal-backdrop-c" @onclick="() => _showNew = false">
    <div class="modal-card" @onclick:stopPropagation>
      <h5>New User</h5>
      <div class="mb-2"><label class="form-label">Full Name</label><input class="form-control" @bind="_n.FullName" /></div>
      <div class="mb-2"><label class="form-label">Email</label><input class="form-control" @bind="_n.Email" /></div>
      <div class="mb-2"><label class="form-label">Password</label><input type="password" class="form-control" @bind="_n.Password" /></div>
      <div class="mb-3"><label class="form-label">Role</label>
        <select class="form-select" @bind="_n.Role">
          @foreach (var r in Enum.GetValues<UserRole>()) { <option value="@r">@r</option> }
        </select>
      </div>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-light" @onclick="() => _showNew = false">Cancel</button>
        <button class="btn btn-primary" @onclick="Create">Create</button>
      </div>
    </div>
  </div>
}

@code {
  private List<User> _users = new();
  private bool _showNew;
  private NewUser _n = new();
  private class NewUser { public string FullName{get;set;}=""; public string Email{get;set;}=""; public string Password{get;set;}=""; public UserRole Role{get;set;}=UserRole.Student; }
  protected override async Task OnInitializedAsync() => _users = await UserService.GetAllUsers();
  private async Task Create()
  {
    var u = await UserService.CreateUser(_n.FullName, _n.Email, _n.Password, _n.Role);
    if (u != null) { await AuditService.LogActionAsync(AuthService.CurrentUser?.Id ?? 0, "UserCreate", _n.Email); }
    _showNew = false; _n = new(); _users = await UserService.GetAllUsers();
  }
  private async Task Deactivate(User u)
  {
    await UserService.DeactivateUser(u.Id);
    await AuditService.LogActionAsync(AuthService.CurrentUser?.Id ?? 0, "UserDeactivate", u.Email);
    _users = await UserService.GetAllUsers();
  }
}
