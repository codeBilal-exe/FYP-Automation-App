@page "/admin/reports"
@attribute [Authorize(Roles = "Admin,HOD,Coordinator")]
@inject ReportService ReportService
@inject AppDbContext Db
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore

<div class="page-header"><div><h1>Reports & Analytics</h1><div class="page-subtitle">Project, proposal and evaluation insights.</div></div>
  <button class="btn btn-soft" @onclick="ExportCsv"><i class="bi bi-download me-1"></i>Export CSV</button>
</div>

<div class="row g-3">
  <div class="col-lg-4"><div class="fcard"><div class="fcard-title"><i class="bi bi-folder"></i> Projects</div>
    @foreach (var kv in _proj) { <div class="d-flex justify-content-between py-1 border-bottom"><span>@kv.Key</span><strong>@kv.Value</strong></div> }
  </div></div>
  <div class="col-lg-4"><div class="fcard"><div class="fcard-title"><i class="bi bi-clipboard"></i> Proposals</div>
    @foreach (var kv in _props) { <div class="d-flex justify-content-between py-1 border-bottom"><span>@kv.Key</span><strong>@kv.Value</strong></div> }
  </div></div>
  <div class="col-lg-4"><div class="fcard"><div class="fcard-title"><i class="bi bi-star"></i> Evaluations</div>
    @foreach (var kv in _evals) { <div class="d-flex justify-content-between py-1 border-bottom"><span>@kv.Key</span><strong>@kv.Value</strong></div> }
  </div></div>
  <div class="col-lg-6"><div class="fcard"><div class="fcard-title"><i class="bi bi-bar-chart"></i> Milestones / Month</div><canvas id="repMs" height="200"></canvas></div></div>
  <div class="col-lg-6"><div class="fcard"><div class="fcard-title"><i class="bi bi-graph-up"></i> Proposal Trend</div><canvas id="repProp" height="200"></canvas></div></div>
</div>

@code {
  private Dictionary<string,object> _proj = new(), _props = new(), _evals = new();
  private Dictionary<string,int> _ms = new(), _trend = new();
  protected override async Task OnInitializedAsync()
  {
    _proj = await ReportService.GetProjectStatistics();
    _props = await ReportService.GetProposalStatistics();
    _evals = await ReportService.GetEvaluationStatistics();
    _ms = await ReportService.GetMilestoneCompletionByMonth();
    _trend = await ReportService.GetProposalSubmissionTrend();
  }
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    await JS.InvokeVoidAsync("fypSite.drawChart", "repMs", new {
      type = "bar",
      data = new { labels = _ms.Keys.ToArray(), datasets = new[]{ new { label="Completed", data=_ms.Values.ToArray(), backgroundColor="#6366f1" } } },
      options = new { animation = new { easing = "easeInOutQuart" } }
    });
    await JS.InvokeVoidAsync("fypSite.drawChart", "repProp", new {
      type = "line",
      data = new { labels = _trend.Keys.ToArray(), datasets = new[]{ new { label="Submissions", data=_trend.Values.ToArray(), borderColor="#22c55e", backgroundColor="rgba(34,197,94,.15)", fill=true, tension=0.35 } } },
      options = new { animation = new { easing = "easeInOutQuart" } }
    });
  }
  private async Task ExportCsv()
  {
    var users = await Db.Users.ToListAsync();
    var csv = ReportService.ExportToCSV(users);
    await JS.InvokeVoidAsync("fypSite.downloadFile", "users.csv", csv, "text/csv");
  }
}
