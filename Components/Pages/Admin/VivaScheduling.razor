@page "/coordinator/viva"
@page "/admin/viva"
@attribute [Authorize(Roles = "Coordinator")]
@inject AppDbContext Db
@inject VivaService VivaService
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Globalization

<div class="page-header">
  <div><h1>Viva Scheduling</h1><div class="page-subtitle">Schedule viva, presentation & evaluation slots · Assign available faculty panel</div></div>
  <button class="btn btn-primary" @onclick="OpenNewSlotDialog"><i class="bi bi-plus-lg me-1"></i>Schedule New Slot</button>
</div>

@* ── Scheduled slots table ── *@
<div class="fcard mb-3">
  <div class="fcard-title d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><i class="bi bi-calendar2-week"></i> Scheduled Slots</div>
    <div style="width: 250px;">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control border-start-0 ps-0" placeholder="Search by Group..." @bind="_searchGroup" @bind:event="oninput" />
      </div>
    </div>
  </div>
  @if (!FilteredSlots.Any())
  {
    <div class="empty-state"><i class="bi bi-calendar-x"></i>No scheduled slots found.</div>
  }
  else
  {
    <div class="viva-card-grid">
      @foreach (var s in FilteredSlots)
      {
        <article class="viva-card">
          <header class="viva-card-head">
            <div class="viva-card-day">
              <div class="viva-card-dow">@s.ScheduledAt.ToString("ddd")</div>
              <div class="viva-card-date">@s.ScheduledAt.ToString("dd")</div>
              <div class="viva-card-month">@s.ScheduledAt.ToString("MMM yyyy")</div>
            </div>
            <div class="viva-card-meta">
              <div class="viva-card-time">
                <i class="bi bi-clock"></i>
                <span>@FormatTime(s.StartTime) – @FormatTime(s.EndTime)</span>
              </div>
              <div class="viva-card-badges">
                <span class="fbadge @SlotTypeClass(s.SlotType)">@s.SlotType</span>
                <span class="fbadge @(s.Status.ToString().ToLower())">@s.Status</span>
              </div>
            </div>
            <div class="viva-card-actions">
              @if (s.Status == VivaStatus.Scheduled)
              {
                <button class="btn btn-sm btn-soft" title="Edit" @onclick="() => EditSlot(s)"><i class="bi bi-pencil"></i></button>
              }
              <button class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => DeleteSlot(s)"><i class="bi bi-trash"></i></button>
            </div>
          </header>

          <div class="viva-card-body">
            <div class="viva-card-row">
              <span class="viva-card-label"><i class="bi bi-people"></i> Group</span>
              <span class="viva-card-value">@(s.Group?.GroupName ?? "—")</span>
            </div>
            <div class="viva-card-row">
              <span class="viva-card-label"><i class="bi bi-geo-alt"></i> Venue</span>
              <span class="viva-card-value">@s.Venue</span>
            </div>
            <div class="viva-card-panel">
              <div class="viva-card-label mb-1"><i class="bi bi-person-badge"></i> Panel</div>
              @if (s.PanelMembers.Count == 0)
              {
                <span class="text-muted small">No panel assigned</span>
              }
              else
              {
                <div class="viva-card-chips">
                  @foreach (var pm in s.PanelMembers)
                  {
                    <span class="viva-panel-chip">@pm.FullName</span>
                  }
                </div>
              }
            </div>
          </div>
        </article>
      }
    </div>
  }
</div>

@* ── Upload Faculty Timetable ── *@
<div class="fcard mb-3">
  <div class="fcard-title"><i class="bi bi-cloud-arrow-up"></i> Upload Faculty Timetable</div>
  <p class="text-muted" style="font-size:.85rem">Upload a CSV or Excel (.xlsx) file from the university database. The system will store faculty schedules and use them to filter available panel members during slot scheduling.</p>

  <div class="viva-upload-info mb-3">
    <div class="fw-bold mb-1" style="font-size:.82rem">Required Columns:</div>
    <code style="font-size:.78rem">FacultyEmail, Day, StartTime, EndTime, Subject, RoomNumber</code>
    <div class="text-muted mt-1" style="font-size:.78rem">
      Day: Monday/Tuesday/... or Mon/Tue/... · Time: HH:mm (e.g. 09:00, 14:30) · Faculty must be a registered user.
    </div>
  </div>

  <div class="d-flex gap-2 align-items-center flex-wrap">
    <InputFile OnChange="HandleFileUpload" accept=".csv,.xlsx" class="form-control" style="max-width:400px" />
    @if (_uploading)
    {
      <div class="d-flex align-items-center gap-2 text-muted"><div class="fspinner" style="width:22px;height:22px;border-width:2px"></div> Importing...</div>
    }
  </div>

  @if (_uploadResult != null)
  {
    var ur = _uploadResult.Value;
    <div class="mt-2 py-2 px-3 rounded-3" style="background: @(ur.Errors.Count > 0 ? "rgba(239,68,68,.08)" : "rgba(34,197,94,.08)"); font-size:.85rem">
      <strong>@ur.Imported imported</strong>, @ur.Skipped skipped.
      @if (ur.Errors.Count > 0)
      {
        <ul class="mt-1 mb-0" style="padding-left:1.2rem">
          @foreach (var e in ur.Errors.Take(5))
          {
            <li class="text-danger">@e</li>
          }
          @if (ur.Errors.Count > 5)
          {
            <li class="text-muted">...and @(ur.Errors.Count - 5) more</li>
          }
        </ul>
      }
    </div>
  }

  <div class="text-muted mt-2" style="font-size:.8rem">
    <i class="bi bi-database-check me-1"></i> Current timetable entries in database: <strong>@_timetableCount</strong>
  </div>
</div>

@* ── New Slot Modal ── *@
@if (_showModal)
{
  <div class="modal-backdrop-c" @onclick="() => _showModal = false">
    <div class="modal-card viva-modal-wide" @onclick:stopPropagation>
      <h5 class="mb-3"><i class="bi @(_isEditing ? "bi-pencil-square" : "bi-calendar-plus") me-2"></i>@(_isEditing ? "Edit Scheduled Slot" : "Schedule New Slot")</h5>

      @if (!string.IsNullOrEmpty(_error))
      {
        <div class="viva-alert-danger">@_error</div>
      }

      <div class="viva-row mb-3">
        <div class="viva-col">
          <label class="form-label">Date</label>
          <input type="date" class="form-control" @bind="_newDate" @bind:after="OnDateOrGroupChanged" />
        </div>
      </div>

      <div class="viva-row mb-3">
        <div class="viva-col">
          <label class="form-label">Slot Type</label>
          <select class="form-select" @bind="_newSlotType">
            <option value="@SlotType.Viva">Viva</option>
            <option value="@SlotType.Presentation">Presentation</option>
            <option value="@SlotType.Evaluation">Evaluation</option>
            <option value="@SlotType.DocumentSubmission">Document Submission</option>
          </select>
        </div>
        <div class="viva-col">
          <label class="form-label">Group</label>
          <select class="form-select" @bind="_newGroupId" @bind:after="OnDateOrGroupChanged" disabled="@_isEditing">
            <option value="0">— Select Group —</option>
            @foreach (var g in _groups)
            {
              <option value="@g.Id">@g.GroupName (@g.Department) · Sup: @(g.Supervisor?.FullName ?? "Unassigned")</option>
            }
          </select>
        </div>
        <div class="viva-col">
          <label class="form-label">Venue</label>
          <input class="form-control" @bind="_newVenue" placeholder="e.g. CS-Lab-1" />
        </div>
      </div>

      <div class="viva-panel-section mb-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <label class="form-label mb-0 fw-bold"><i class="bi bi-calendar3 me-1"></i>Find Supervisor-Based Free Slots</label>
          <button class="btn btn-sm btn-primary" @onclick="FetchSupervisorSlots" disabled="@_fetchingFaculty">
            @if (_fetchingFaculty)
            {
              <span class="spinner-border spinner-border-sm me-1"></span>
            }
            <i class="bi bi-search me-1"></i>Find Slots
          </button>
        </div>

        <div class="text-muted mb-2" style="font-size:.82rem">
          Select a date and group. The system first finds free slots for the group's supervisor, then computes available panel/supervisor members for each slot.
        </div>

        @if (_fetchingFaculty)
        {
          <div class="text-muted py-2" style="font-size:.85rem"><i class="bi bi-hourglass-split me-1"></i>Finding free slots for supervisor and panel...</div>
        }
        else if (_slotOptions != null)
        {
          @if (_slotOptions.Count == 0)
          {
            <div class="text-muted py-2" style="font-size:.85rem"><i class="bi bi-exclamation-circle me-1"></i>No free slots found for this supervisor on the selected day.</div>
          }
          else
          {
            <div class="viva-slot-pick-grid">
              @foreach (var slot in _slotOptions)
              {
                var isSelected = _selectedSlot != null &&
                                 _selectedSlot.StartTime == slot.StartTime &&
                                 _selectedSlot.EndTime == slot.EndTime;
                <div class="viva-slot-pick @(isSelected ? "selected" : "")" @onclick="() => SelectSlot(slot)">
                  <div class="fw-bold">@FormatTime(slot.StartTime) – @FormatTime(slot.EndTime)</div>
                  <div class="text-muted" style="font-size:.78rem">@slot.AvailablePanelMembers.Count available panel/supervisor members</div>
                </div>
              }
            </div>
          }
        }
      </div>

      @* Panel assignment section *@
      <div class="viva-panel-section mb-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <label class="form-label mb-0 fw-bold"><i class="bi bi-people-fill me-1"></i>Assign Panel Members (up to 6)</label>
        </div>

        @if (_modalAvailFaculty != null)
        {
          @if (_modalAvailFaculty.Count == 0)
          {
            <div class="text-muted py-2" style="font-size:.85rem"><i class="bi bi-exclamation-circle me-1"></i>No panel/supervisor members available for the selected slot.</div>
          }
          else
          {
            <p class="text-muted mb-2" style="font-size:.82rem"><strong>@_modalAvailFaculty.Count</strong> panel/supervisor members available for @_newDate.ToString("ddd, MMM dd") · @FormatTime(_selectedSlot?.StartTime ?? TimeSpan.Zero) – @FormatTime(_selectedSlot?.EndTime ?? TimeSpan.Zero)</p>
            <div class="viva-faculty-pick-grid">
              @foreach (var f in _modalAvailFaculty)
              {
                var isSelected = _selectedPanelIds.Contains(f.Id);
                <div class="viva-faculty-pick @(isSelected ? "selected" : "")" @onclick="() => TogglePanel(f.Id)">
                  <div class="viva-faculty-avatar sm">@f.FullName[0]</div>
                  <div>
                    <div class="fw-bold" style="font-size:.85rem">@f.FullName</div>
                    <div class="text-muted" style="font-size:.72rem">@f.Role · @(f.Expertise ?? "General")</div>
                  </div>
                  <i class="bi @(isSelected ? "bi-check-circle-fill text-success" : "bi-circle") ms-auto"></i>
                </div>
              }
            </div>
            <div class="text-muted mt-1" style="font-size:.78rem">Selected: @_selectedPanelIds.Count / 6</div>
          }
        }
        else
        {
          <div class="text-muted py-2" style="font-size:.85rem">Find and select a supervisor free slot first. Then choose panel members available on that exact slot.</div>
        }
      </div>

      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-light" @onclick="() => _showModal = false">Cancel</button>
        <button class="btn btn-primary" @onclick="SaveSlot" disabled="@_creating">
          @if (_creating)
          {
            <span class="spinner-border spinner-border-sm me-1"></span>
          }
          @(_isEditing ? "Save Changes" : "Schedule Slot")
        </button>
      </div>
    </div>
  </div>
}

@code {
  // ── State ──
  private List<VivaSlot> _slots = new();
  private List<Group> _groups = new();
  private int _timetableCount;
  private string _searchGroup = "";

  private IEnumerable<VivaSlot> FilteredSlots => string.IsNullOrWhiteSpace(_searchGroup) 
      ? _slots 
      : _slots.Where(s => s.Group?.GroupName != null && s.Group.GroupName.Contains(_searchGroup, StringComparison.OrdinalIgnoreCase));

  // New slot modal
  private bool _showModal;
  private DateTime _newDate = DateTime.Today.AddDays(7);
  private SlotType _newSlotType = SlotType.Viva;
  private int _newGroupId;
  private string _newVenue = "";
  private List<SupervisorSlotAvailability>? _slotOptions;
  private SupervisorSlotAvailability? _selectedSlot;
  private List<User>? _modalAvailFaculty;
  private HashSet<int> _selectedPanelIds = new();
  private bool _creating;
  private bool _fetchingFaculty;
  private string _error = "";
  private bool _isEditing;
  private int _editSlotId;

  // Upload
  private bool _uploading;
  private (int Imported, int Skipped, List<string> Errors)? _uploadResult;

  protected override async Task OnInitializedAsync() => await Load();

  private async Task Load()
  {
    _slots = await VivaService.GetAllScheduledSlots();
    _groups = await Db.Groups
      .Include(g => g.Project)
      .Include(g => g.Supervisor)
      .OrderBy(g => g.GroupName)
      .ToListAsync();
    _timetableCount = await VivaService.GetTimetableCount();
  }

  // ── New slot modal ──
  private void OpenNewSlotDialog()
  {
    _showModal = true;
    _newDate = DateTime.Today.AddDays(7);
    _newSlotType = SlotType.Viva;
    _newGroupId = 0;
    _newVenue = "";
    _slotOptions = null;
    _selectedSlot = null;
    _modalAvailFaculty = null;
    _selectedPanelIds = new();
    _error = "";
    _creating = false;
    _fetchingFaculty = false;
    _isEditing = false;
    _editSlotId = 0;
  }

  private Task OnDateOrGroupChanged()
  {
    _slotOptions = null;
    _selectedSlot = null;
    _modalAvailFaculty = null;
    _selectedPanelIds = new();
    _error = "";
    return Task.CompletedTask;
  }

  private async Task FetchSupervisorSlots()
  {
    _fetchingFaculty = true;
    _error = "";
    _slotOptions = null;
    _selectedSlot = null;
    _modalAvailFaculty = null;
    _selectedPanelIds = new();
    StateHasChanged();

    try
    {
      if (_newGroupId == 0)
      {
        _error = "Please select a group first.";
        _slotOptions = new List<SupervisorSlotAvailability>();
        return;
      }

      if (_newDate.Date < DateTime.Today)
      {
        _error = "Date cannot be in the past.";
        _slotOptions = new List<SupervisorSlotAvailability>();
        return;
      }

      _slotOptions = await VivaService.GetSupervisorBasedAvailabilityForGroupDay(_newGroupId, _newDate, 30);
    }
    catch (Exception ex)
    {
      _error = $"Error finding slots: {ex.Message}";
      _slotOptions = new List<SupervisorSlotAvailability>();
    }
    finally
    {
      _fetchingFaculty = false;
    }
  }

  private void SelectSlot(SupervisorSlotAvailability slot)
  {
    _selectedSlot = slot;
    _modalAvailFaculty = slot.AvailablePanelMembers.ToList();
    _selectedPanelIds = new();
    _error = "";
  }

  private void TogglePanel(int id)
  {
    if (_selectedPanelIds.Contains(id))
      _selectedPanelIds.Remove(id);
    else if (_selectedPanelIds.Count < 6)
      _selectedPanelIds.Add(id);
  }

  private async Task SaveSlot()
  {
    _error = "";
    if (_newGroupId == 0) { _error = "Please select a group."; return; }
    if (string.IsNullOrWhiteSpace(_newVenue)) { _error = "Please enter a venue."; return; }
    if (_newDate.Date < DateTime.Today && !_isEditing) { _error = "Date cannot be in the past."; return; }
    if (_selectedSlot == null) { _error = "Please select one supervisor free slot."; return; }
    if (_selectedPanelIds.Count == 0) { _error = "Please assign at least one panel member."; return; }

    _creating = true;

    if (_isEditing)
    {
      var updated = new VivaSchedule
      {
        SlotId = _editSlotId,
        Date = _newDate,
        StartTime = _selectedSlot.StartTime,
        EndTime = _selectedSlot.EndTime,
        Venue = _newVenue,
        PanelMemberIds = _selectedPanelIds.ToList()
      };

      var outcome = await VivaService.UpdateVivaAsync(updated);

      if (outcome.Result != ScheduleResult.Ok || outcome.Slot == null)
      {
        _error = outcome.Message;
        if (outcome.Result == ScheduleResult.SlotNotFreeForSupervisor ||
            outcome.Result == ScheduleResult.SupervisorHasOverlappingViva ||
            outcome.Result == ScheduleResult.VenueDoubleBooked ||
            outcome.Result == ScheduleResult.GroupDoubleBooked ||
            outcome.Result == ScheduleResult.PanelMemberBusy)
        {
          await FetchSupervisorSlots();
        }
        _creating = false;
        return;
      }
    }
    else
    {
      var outcome = await VivaService.CreateScheduledSlot(
          _newDate, _selectedSlot.StartTime, _selectedSlot.EndTime, _newVenue, _newGroupId, null, _newSlotType,
          _selectedPanelIds.ToList());

      if (outcome.Result != ScheduleResult.Ok || outcome.Slot == null)
      {
        _error = outcome.Message;
        if (outcome.Result == ScheduleResult.SlotNotFreeForSupervisor ||
            outcome.Result == ScheduleResult.SupervisorHasOverlappingViva ||
            outcome.Result == ScheduleResult.VenueDoubleBooked ||
            outcome.Result == ScheduleResult.GroupDoubleBooked ||
            outcome.Result == ScheduleResult.PanelMemberBusy)
        {
          await FetchSupervisorSlots();
        }
        _creating = false;
        return;
      }
    }

    _showModal = false;
    _creating = false;
    await Load();
  }

  private async Task EditSlot(VivaSlot s)
  {
    _isEditing = true;
    _editSlotId = s.Id;
    _newDate = s.ScheduledAt.ToLocalTime().Date;
    _newSlotType = s.SlotType;
    _newGroupId = s.GroupId ?? 0;
    _newVenue = s.Venue;
    
    _showModal = true;
    _error = "";
    _creating = false;
    _fetchingFaculty = false;
    
    await FetchSupervisorSlots();
    
    if (_slotOptions != null)
    {
        var matchingSlot = _slotOptions.FirstOrDefault(opt => opt.StartTime == s.StartTime && opt.EndTime == s.EndTime);
        if (matchingSlot != null)
        {
            SelectSlot(matchingSlot);
            _selectedPanelIds = s.PanelMembers.Select(p => p.Id).ToHashSet();
        }
    }
  }

  private async Task DeleteSlot(VivaSlot s)
  {
    await VivaService.DeleteVivaSlot(s.Id);
    await Load();
  }

  // ── File upload ──
  private async Task HandleFileUpload(InputFileChangeEventArgs e)
  {
    _uploading = true;
    _uploadResult = null;
    StateHasChanged();

    try
    {
      var file = e.File;
      var ext = Path.GetExtension(file.Name).ToLowerInvariant();

      List<TimetableImportRow> rows;

      using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
      using var ms = new MemoryStream();
      await stream.CopyToAsync(ms);
      ms.Position = 0;

      if (ext == ".csv")
      {
        rows = ParseCsv(ms);
      }
      else if (ext == ".xlsx")
      {
        rows = ParseExcel(ms);
      }
      else
      {
        _uploadResult = (0, 0, new List<string> { "Unsupported file format. Use .csv or .xlsx" });
        _uploading = false;
        return;
      }

      if (rows.Count == 0)
      {
        _uploadResult = (0, 0, new List<string> { "No data rows found in the file." });
        _uploading = false;
        return;
      }

      _uploadResult = await VivaService.ImportTimetableAsync(rows);
      _timetableCount = await VivaService.GetTimetableCount();
    }
    catch (Exception ex)
    {
      _uploadResult = (0, 0, new List<string> { $"Upload error: {ex.Message}" });
    }
    finally
    {
      _uploading = false;
    }
  }

  private static List<TimetableImportRow> ParseCsv(Stream stream)
  {
    var rows = new List<TimetableImportRow>();
    using var reader = new StreamReader(stream);
    var headerLine = reader.ReadLine();
    if (headerLine == null) return rows;

    while (!reader.EndOfStream)
    {
      var line = reader.ReadLine();
      if (string.IsNullOrWhiteSpace(line)) continue;

      var parts = line.Split(',');
      if (parts.Length < 4) continue;

      rows.Add(new TimetableImportRow
      {
        FacultyEmail = parts[0].Trim(),
        Day = parts[1].Trim(),
        StartTime = parts[2].Trim(),
        EndTime = parts[3].Trim(),
        Subject = parts.Length > 4 ? parts[4].Trim() : "",
        RoomNumber = parts.Length > 5 ? parts[5].Trim() : ""
      });
    }
    return rows;
  }

  private static List<TimetableImportRow> ParseExcel(Stream stream)
  {
    var rows = new List<TimetableImportRow>();
    try
    {
      using var workbook = new ClosedXML.Excel.XLWorkbook(stream);
      var ws = workbook.Worksheets.First();
      var lastRow = ws.LastRowUsed()?.RowNumber() ?? 0;

      for (int r = 2; r <= lastRow; r++)
      {
        var email = ws.Cell(r, 1).GetString().Trim();
        if (string.IsNullOrWhiteSpace(email)) continue;

        rows.Add(new TimetableImportRow
        {
          FacultyEmail = email,
          Day = ws.Cell(r, 2).GetString().Trim(),
          StartTime = ws.Cell(r, 3).GetString().Trim(),
          EndTime = ws.Cell(r, 4).GetString().Trim(),
          Subject = ws.Cell(r, 5).GetString().Trim(),
          RoomNumber = ws.Cell(r, 6).GetString().Trim()
        });
      }
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Excel parse error: {ex.Message}");
    }
    return rows;
  }

  // ── Helpers ──
  private static string FormatTime(TimeSpan t) => $"{t.Hours:00}:{t.Minutes:00}";

  private static string SlotTypeClass(SlotType t) => t switch
  {
    SlotType.Viva => "info",
    SlotType.Presentation => "warning",
    SlotType.Evaluation => "success",
    SlotType.DocumentSubmission => "active",
    _ => "info"
  };
}

<style>
  .viva-modal-wide { max-width: 720px; }
  .viva-panel-chip {
    display: inline-block;
    background: var(--primary-glow);
    color: var(--primary-700);
    padding: 2px 10px;
    border-radius: 999px;
    font-size: .75rem;
    font-weight: 600;
    margin: 2px 3px;
  }
  .viva-faculty-avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), #8b5cf6);
    color: #fff;
    display: grid; place-items: center;
    font-weight: 700; font-size: .85rem;
    flex-shrink: 0;
  }
  .viva-faculty-avatar.sm { width: 32px; height: 32px; font-size: .75rem; }
  .viva-faculty-pick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: .5rem;
  }
  .viva-slot-pick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: .5rem;
  }
  .viva-slot-pick {
    padding: .6rem .7rem;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: #fff;
    cursor: pointer;
    transition: all .18s ease;
  }
  .viva-slot-pick:hover {
    border-color: var(--primary);
    background: var(--primary-glow);
  }
  .viva-slot-pick.selected {
    border-color: var(--success);
    background: rgba(34,197,94,.08);
    box-shadow: 0 0 0 3px rgba(34,197,94,.15);
  }
  .viva-faculty-pick {
    display: flex;
    align-items: center;
