@page "/hod/proposals"
@attribute [Authorize(Roles = "HOD")]
@inject ProposalService ProposalService
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider
@using Microsoft.EntityFrameworkCore

<div class="page-header">
  <div><h1>HOD Proposal Review</h1><div class="page-subtitle">Review supervisor-approved proposals and forward to coordinator.</div></div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
  <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrWhiteSpace(_msg))
{
  <div class="alert alert-success">@_msg</div>
}

<div class="fcard">
  @if (!_rows.Any())
  {
    <div class="empty-state"><i class="bi bi-clipboard"></i>No pending HOD proposals.</div>
  }
  else
  {
    <table class="ftable">
      <thead>
        <tr><th>Title</th><th>Group</th><th>Submitted</th><th>Status</th><th class="text-end">Actions</th></tr>
      </thead>
      <tbody>
        @foreach (var row in _rows)
        {
          <tr>
            <td>
              <div class="fw-semibold">@row.Proposal.Title</div>
              @if (!string.IsNullOrWhiteSpace(row.Proposal.DocumentPath))
              {
                <div class="small"><a href="@($"/files/proposal/{row.Proposal.Id}")" target="_blank">Download / View Document</a></div>
              }
            </td>
            <td>@row.GroupName</td>
            <td>@row.Proposal.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td><span class="fbadge warning">@row.Proposal.Status</span></td>
            <td class="text-end">
              <button class="btn btn-sm btn-success me-1" @onclick="() => OpenApprove(row.Proposal)">Approve</button>
              <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenReject(row.Proposal)">Reject</button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>

@if (_selected != null)
{
  <div class="modal-backdrop-c" @onclick="CloseDialog">
    <div class="modal-card" @onclick:stopPropagation>
      <h5>@(_isReject ? "Reject Proposal" : "Approve Proposal")</h5>
      <p class="text-muted small">Project: @_selected.Title</p>
      <label class="form-label">Comments @(_isReject ? "(required)" : "(optional)")</label>
      <textarea class="form-control mb-3" rows="4" @bind="_comments"></textarea>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-light" @onclick="CloseDialog">Cancel</button>
        <button class="btn @(_isReject ? "btn-danger" : "btn-success")" @onclick="ConfirmDecision">Confirm</button>
      </div>
    </div>
  </div>
}

@code {
  private List<RowVm> _rows = new();
  private string? _error;
  private string? _msg;
  private Proposal? _selected;
  private bool _isReject;
  private string _comments = string.Empty;
  private int _hodId;

  private sealed class RowVm
  {
    public Proposal Proposal { get; set; } = new();
    public string GroupName { get; set; } = string.Empty;
  }

  protected override async Task OnInitializedAsync()
  {
    var auth = await AuthProvider.GetAuthenticationStateAsync();
    var id = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    _hodId = int.TryParse(id, out var userId) ? userId : 0;
    await Load();
  }

  private async Task Load()
  {
    _selected = null;
    _comments = string.Empty;

    var proposals = await ProposalService.GetPendingProposalsForRoleAsync(UserRole.HOD, _hodId);
    var groupLookup = await Db.Groups.ToDictionaryAsync(g => g.Id, g => g.GroupName);
    _rows = proposals.Select(p => new RowVm
    {
      Proposal = p,
      GroupName = groupLookup.TryGetValue(p.GroupId, out var groupName) ? groupName : "Unknown Group"
    }).ToList();
  }

  private void OpenApprove(Proposal proposal)
  {
    _selected = proposal;
    _isReject = false;
    _comments = string.Empty;
    _error = null;
  }

  private void OpenReject(Proposal proposal)
  {
    _selected = proposal;
    _isReject = true;
    _comments = string.Empty;
    _error = null;
  }

  private void CloseDialog()
  {
    _selected = null;
    _comments = string.Empty;
  }

  private async Task ConfirmDecision()
  {
    if (_selected == null)
      return;

    _error = null;
    _msg = null;

    if (_isReject)
    {
      if (string.IsNullOrWhiteSpace(_comments) || _comments.Trim().Length < 5)
      {
        _error = "Rejection reason is required.";
        return;
      }

      var result = await ProposalService.RejectProposalAsync(_selected.Id, _hodId, UserRole.HOD, _comments.Trim());
      if (!result.Success)
      {
        _error = result.Message;
        return;
      }

      _msg = "Proposal rejected.";
    }
    else
    {
      var result = await ProposalService.ApproveProposalAsync(_selected.Id, _hodId, UserRole.HOD, string.IsNullOrWhiteSpace(_comments) ? null : _comments.Trim());
      if (!result.Success)
      {
        _error = result.Message;
        return;
      }

      _msg = "Proposal approved and forwarded to coordinator.";
    }

    await Load();
  }
}
