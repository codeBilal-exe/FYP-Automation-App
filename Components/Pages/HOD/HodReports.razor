@page "/hod/reports"
@attribute [Authorize(Roles = "HOD")]
@inject ReportService ReportService
@inject AppDbContext Db

<div class="page-header">
  <div><h1>HOD Reports</h1><div class="page-subtitle">Generate and archive accreditation-ready reports.</div></div>
</div>

<div class="fcard mb-3">
  <div class="row g-3">
    <div class="col-md-4">
      <label class="form-label">Report Type</label>
      <select class="form-select" @bind="_reportType">
        <option value="FinalGrade">Final Grade</option>
        <option value="Workload">Workload</option>
        <option value="Milestone">Milestone Completion</option>
        <option value="Departmental">Departmental Summary</option>
        <option value="HEC_PEC">HEC/PEC Accreditation</option>
      </select>
    </div>
    <div class="col-md-2"><label class="form-label">Semester</label><input class="form-control" @bind="_semester" /></div>
    <div class="col-md-2"><label class="form-label">Department</label><input class="form-control" @bind="_department" /></div>
    <div class="col-md-2"><label class="form-label">From Date</label><input class="form-control" type="date" @bind="_fromDate" /></div>
    <div class="col-md-2"><label class="form-label">To Date</label><input class="form-control" type="date" @bind="_toDate" /></div>
    <div class="col-md-2"><label class="form-label">Format</label>
      <select class="form-select" @bind="_format"><option>PDF</option><option>XLSX</option></select>
    </div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" @onclick="Generate">Generate Report</button></div>
  </div>

  @if (!string.IsNullOrWhiteSpace(_error))
  {
    <div class="alert alert-danger mt-3">@_error</div>
  }
  @if (!string.IsNullOrWhiteSpace(_successPath))
  {
    <div class="alert alert-success mt-3">Report generated. <a href="@_successPath" target="_blank">Download</a></div>
  }
</div>

<div class="fcard">
  <div class="fcard-title">Report Archive</div>
  <table class="ftable">
    <thead><tr><th>Type</th><th>Semester</th><th>Department</th><th>Generated At</th><th>Generated By</th><th>Download</th></tr></thead>
    <tbody>
      @foreach (var r in _archive)
      {
        <tr>
          <td>@r.ReportType</td><td>@r.Semester</td><td>@r.Department</td><td>@r.GeneratedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@r.GeneratedByUserId</td>
          <td><a href="@r.FilePath" target="_blank">Download</a></td>
        </tr>
      }
    </tbody>
  </table>
</div>

@code {
  private string _reportType = "FinalGrade";
  private string _semester = "Spring-2026";
  private string _department = "CS";
  private DateTime _fromDate = DateTime.UtcNow.AddMonths(-4);
  private DateTime _toDate = DateTime.UtcNow;
  private string _format = "PDF";
  private string? _error;
  private string? _successPath;
  private List<ReportArchive> _archive = new();

  protected override async Task OnInitializedAsync() => await LoadArchive();

  private async Task Generate()
  {
    _error = null;
    _successPath = null;
    try
    {
      var userId = AuthService.CurrentUser?.Id ?? 0;
      _successPath = await ReportService.GenerateReport(_reportType, _semester, _department, _fromDate, _toDate, _format, userId);
      await LoadArchive();
    }
    catch (Exception ex)
    {
      _error = ex.Message;
    }
  }

  private async Task LoadArchive() => _archive = await ReportService.GetReportArchivesAsync();
}
