@page "/forgot-password"
@layout MainLayout

<section class="auth-page compact-auth-page">
  <div class="auth-ambient auth-ambient-one"></div>
  <div class="auth-ambient auth-ambient-two"></div>

  <div class="auth-showcase">
    <div class="auth-kicker"><i class="bi bi-envelope-check"></i> Account Recovery</div>
    <h1>Forgot your password?</h1>
    <p>Enter your project email. Reset password link will be sent to this same email.</p>
  </div>

  <div class="auth-card pro-auth-card">
    <div class="auth-logo"><i class="bi bi-key-fill"></i></div>
    <h2>Reset Password</h2>
    <p class="text-muted mb-4">Use your project email registered in this system.</p>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
      <div class="alert alert-success py-2 small"><i class="bi bi-check-circle me-1"></i>@_message</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
      <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@_error</div>
    }

    <form method="post" action="/auth/forgot-password" class="login-form">
      <div class="mb-3">
        <label class="form-label" for="projectEmail">Project Email</label>
        <div class="input-icon-wrap">
          <i class="bi bi-envelope"></i>
          <input id="projectEmail" name="projectEmail" class="form-control" type="email" placeholder="you@fyp.edu"
                 autocomplete="username" required />
        </div>
      </div>

      <button class="btn btn-primary w-100 auth-submit" type="submit">
        <span>Send Reset Link</span><i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <div class="mt-3 small">
      <a href="/" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Back to login</a>
    </div>
  </div>
</section>

@code {
  private string? _message;
  private string? _error;

  protected override void OnInitialized()
  {
    var query = new Uri(Navigation.Uri).Query.TrimStart('?')
      .Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Select(part => part.Split('=', 2))
      .ToDictionary(
        part => Uri.UnescapeDataString(part[0]),
        part => part.Length > 1 ? Uri.UnescapeDataString(part[1]) : ""
      );

    if (query.TryGetValue("status", out var status))
    {
      if (status == "sent")
      {
        _message = "Password reset link has been sent to your project email.";
      }
      else if (status == "notfound")
      {
        _error = "Email doesn't exist.";
      }
      else if (status == "supabase_config_missing")
      {
        _error = "Supabase email service is not configured. Reset link could not be sent.";
      }
      else if (status == "send_failed")
      {
        _error = "Failed to send reset email from Supabase. Please try again.";
      }
      else if (status == "rate_limited")
      {
        _error = "Too many reset requests. Supabase built-in email allows only limited sends per hour.";
      }
      else if (status == "not_in_auth")
      {
        _error = "Email exists in app database but not in Supabase Auth users. This account cannot receive Supabase reset email yet.";
      }
      else if (status == "invalid")
      {
        _error = "Please enter a valid email.";
      }
    }
  }

  [Inject] private NavigationManager Navigation { get; set; } = default!;
}
