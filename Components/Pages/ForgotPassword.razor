@page "/forgot-password"
@layout MainLayout

<section class="auth-page">
  <button type="button" class="theme-toggle auth-theme-toggle" data-action="toggle-theme"
          title="Toggle theme" aria-label="Toggle light or dark theme">
    <i class="ti ti-sun bi bi-sun"></i>
    <i class="ti ti-moon bi bi-moon-stars"></i>
  </button>
  <div class="auth-corner-mark">Account · Recovery</div>

  <div class="auth-card pro-auth-card" role="main" aria-labelledby="recover-heading">
    <div class="auth-eyebrow">Forgot password</div>

    <div class="auth-logo" aria-hidden="true"><i class="bi bi-envelope-arrow-up"></i></div>

    <h2 id="recover-heading">Recover <em>access.</em></h2>
    <p class="text-muted">Enter your project email — we'll send a secure reset link to the same address.</p>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
      <div class="alert alert-success" role="status"><i class="bi bi-check-circle me-1"></i>@_message</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
      <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1"></i>@_error</div>
    }

    <form method="post" action="/auth/forgot-password" class="login-form" autocomplete="on">
      <div class="mb-3">
        <label class="form-label" for="projectEmail">Project Email</label>
        <div class="input-icon-wrap">
          <i class="bi bi-envelope field-leading-icon" aria-hidden="true"></i>
          <input id="projectEmail" name="projectEmail" class="form-control" type="email"
                 placeholder="you@fyp.edu" autocomplete="username" required />
        </div>
      </div>

      <button class="btn btn-primary w-100 auth-submit" type="submit">
        <span>Send reset link</span><i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <div class="auth-foot">
      <a href="/"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
    </div>
  </div>
</section>

@code {
  private string? _message;
  private string? _error;

  protected override void OnInitialized()
  {
    var query = new Uri(Navigation.Uri).Query.TrimStart('?')
      .Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Select(part => part.Split('=', 2))
      .ToDictionary(
        part => Uri.UnescapeDataString(part[0]),
        part => part.Length > 1 ? Uri.UnescapeDataString(part[1]) : ""
      );

    if (query.TryGetValue("status", out var status))
    {
      if (status == "sent")
      {
        _message = "Password reset link has been sent to your project email.";
      }
      else if (status == "notfound")
      {
        _error = "Email doesn't exist.";
      }
      else if (status == "supabase_config_missing")
      {
        _error = "Supabase email service is not configured. Reset link could not be sent.";
      }
      else if (status == "send_failed")
      {
        _error = "Failed to send reset email from Supabase. Please try again.";
      }
      else if (status == "rate_limited")
      {
        _error = "Too many reset requests. Supabase built-in email allows only limited sends per hour.";
      }
      else if (status == "not_in_auth")
      {
        _error = "Email exists in app database but not in Supabase Auth users. This account cannot receive Supabase reset email yet.";
      }
      else if (status == "invalid")
      {
        _error = "Please enter a valid email.";
      }
    }
  }

  [Inject] private NavigationManager Navigation { get; set; } = default!;
}
