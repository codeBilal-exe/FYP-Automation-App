@page "/"
@layout MainLayout
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<section class="auth-page compact-auth-page">
  <div class="auth-ambient auth-ambient-one"></div>
  <div class="auth-ambient auth-ambient-two"></div>

  <div class="auth-showcase">
    <div class="auth-kicker"><i class="bi bi-shield-check"></i> Secure Access</div>
    <h1>FYP Automation System</h1>
    <p>Sign in to continue to your role-based workspace for proposals, milestones, documents, and evaluations.</p>

    <ul class="auth-highlights" aria-label="platform highlights">
      <li><i class="bi bi-check-circle-fill"></i><span>Role-based dashboards for students, supervisors, HOD, coordinator, and admin.</span></li>
      <li><i class="bi bi-check-circle-fill"></i><span>Centralized workflow for proposal review to final viva.</span></li>
      <li><i class="bi bi-check-circle-fill"></i><span>Built-in communication, tracking, and reporting tools.</span></li>
    </ul>
  </div>

  <div class="auth-card pro-auth-card">
    <div class="auth-logo"><i class="bi bi-mortarboard-fill"></i></div>
    <h2>Sign in</h2>
    <p class="text-muted mb-4">Enter your credentials to access the platform.</p>

    @if (!string.IsNullOrEmpty(_error))
    {
      <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@_error</div>
    }

    <form method="post" action="/auth/login" class="login-form">
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <div class="input-icon-wrap">
          <i class="bi bi-envelope"></i>
          <input id="email" name="email" class="form-control" type="email" value="@_email" placeholder="you@fyp.edu"
                 autocomplete="username" required />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <div class="input-icon-wrap">
          <i class="bi bi-lock"></i>
          <input id="password" name="password" type="password" class="form-control" placeholder="••••••••"
                 autocomplete="current-password" required />
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-3 small text-muted">
        <div class="form-check mb-0">
          <input class="form-check-input" type="checkbox" id="remember" />
          <label class="form-check-label" for="remember">Remember me</label>
        </div>
        <span>Need access? Contact admin.</span>
      </div>

      <button class="btn btn-primary w-100 auth-submit" type="submit">
        <span>Sign in</span><i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <div class="demo-creds mt-4">
      <div class="demo-title"><i class="bi bi-key"></i> Demo accounts</div>
      <button type="button" class="demo-pill" data-email="admin@fyp.edu" data-password="Admin@123">Admin</button>
      <button type="button" class="demo-pill" data-email="supervisor1@fyp.edu" data-password="Super@123">Supervisor</button>
      <button type="button" class="demo-pill" data-email="student1@fyp.edu" data-password="Student@123">Student</button>
      <button type="button" class="demo-pill" data-email="hod@fyp.edu" data-password="HOD@123">HOD</button>
      <button type="button" class="demo-pill" data-email="coordinator@fyp.edu" data-password="Coord@123">Coordinator</button>
    </div>
  </div>
</section>

@code {
  private string? _error;
  private string _email = "";

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    if (authState.User.Identity?.IsAuthenticated == true)
    {
      Nav.NavigateTo("/dashboard");
      return;
    }

    var query = new Uri(Nav.Uri).Query.TrimStart('?')
      .Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Select(part => part.Split('=', 2))
      .ToDictionary(
        part => Uri.UnescapeDataString(part[0]),
        part => part.Length > 1 ? Uri.UnescapeDataString(part[1]) : ""
      );

    if (query.TryGetValue("error", out var error))
    {
      _error = error == "locked" ? "Account locked. Try again later." : "Invalid email or password.";
    }

    if (query.TryGetValue("email", out var email))
    {
      _email = email;
    }
  }
}
