@page "/"
@layout MainLayout
@using FYP_AutomationSystem.Models
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<section class="auth-page">
  <button type="button" class="theme-toggle auth-theme-toggle" data-action="toggle-theme"
          title="Toggle theme (⌘/Ctrl+J)" aria-label="Toggle light or dark theme">
    <i class="ti ti-sun bi bi-sun"></i>
    <i class="ti ti-moon bi bi-moon-stars"></i>
  </button>
  <div class="auth-corner-mark">Final Year Project · Workflow OS</div>

  <div class="auth-card pro-auth-card" role="main" aria-labelledby="signin-heading">
    <div class="auth-eyebrow">Member Access · v2</div>

    <div class="auth-logo" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></div>

    <h2 id="signin-heading">Welcome <em>back.</em></h2>
    <p class="text-muted">Sign in to coordinate proposals, milestones, and viva schedules in one place.</p>

    @if (!string.IsNullOrEmpty(_error))
    {
      <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1"></i>@_error</div>
    }
    @if (!string.IsNullOrEmpty(_info))
    {
      <div class="alert alert-success" role="status"><i class="bi bi-check-circle me-1"></i>@_info</div>
    }

    <form method="post" action="/auth/login" class="login-form" autocomplete="on">
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <div class="input-icon-wrap">
          <i class="bi bi-envelope field-leading-icon" aria-hidden="true"></i>
          <input id="email" name="email" class="form-control" type="email" value="@_email"
                 placeholder="you@fyp.com" autocomplete="username" required />
        </div>
      </div>

      <div class="mb-2">
        <label class="form-label" for="password">Password</label>
        <div class="input-icon-wrap">
          <i class="bi bi-lock field-leading-icon" aria-hidden="true"></i>
          <input id="password" name="password" type="@(_showPassword ? "text" : "password")"
                 class="form-control password-field" placeholder="••••••••"
                 autocomplete="current-password" required />
          <button type="button" class="password-toggle-btn"
                  @onclick="TogglePasswordVisibility"
                  aria-label="@(_showPassword ? "Hide password" : "Show password")">
            <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
          </button>
        </div>
      </div>

      <div class="remember-row">
        <div class="form-check mb-0">
          <input class="form-check-input" type="checkbox" id="remember" name="remember" />
          <label class="form-check-label" for="remember">Remember me</label>
        </div>
        <a href="/forgot-password">Forgot password?</a>
      </div>

      <button class="btn btn-primary w-100 auth-submit" type="submit">
        <span>Sign in</span><i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <div class="demo-creds" aria-label="Demo accounts">
      <div class="demo-title"><i class="bi bi-key-fill"></i> Demo accounts</div>
      @foreach (var cred in _demoCredentials)
      {
        <button type="button" class="demo-pill"
                data-email="@cred.Email" data-password="@cred.Password"
                aria-label="@($"Fill {cred.Label} demo credentials")">@cred.Label</button>
      }
    </div>

    <div class="auth-foot">
      Trouble signing in? <a href="/forgot-password">Recover access</a>
    </div>
  </div>
</section>

@code {
  private string? _error;
  private string? _info;
  private string _email = "";
  private bool _showPassword;
  private IReadOnlyList<DemoCredential> _demoCredentials = Array.Empty<DemoCredential>();

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    if (authState.User.Identity?.IsAuthenticated == true)
    {
      Nav.NavigateTo("/dashboard");
      return;
    }

    var query = new Uri(Nav.Uri).Query.TrimStart('?')
      .Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Select(part => part.Split('=', 2))
      .ToDictionary(
        part => Uri.UnescapeDataString(part[0]),
        part => part.Length > 1 ? Uri.UnescapeDataString(part[1]) : ""
      );

    if (query.TryGetValue("error", out var error))
    {
      _error = error == "locked" ? "Account locked. Try again later." : "Invalid email or password.";
    }

    if (query.TryGetValue("reset", out var resetStatus) && resetStatus == "success")
    {
      _info = "Your password has been reset. Please sign in with your new password.";
    }

    if (query.TryGetValue("email", out var email))
    {
      _email = email;
    }

    _demoCredentials = LoadDemoCredentials();
  }

  private void TogglePasswordVisibility()
  {
    _showPassword = !_showPassword;
  }

  private static IReadOnlyList<DemoCredential> LoadDemoCredentials()
  {
    var fallback = new List<DemoCredential>
    {
      new("Admin", "admin@fyp.com", "Admin@System"),
      new("Coordinator", "hassan.qureshi@coordinator.fyp.com", "Coordinator@Hassan"),
      new("HOD", "dr.kamran.ali@hod.fyp.com", "HOD@Kamran"),
      new("Supervisor", "sara.malik@supervisor.fyp.com", "Supervisor@Sara"),
      new("Panel Member", "adnan.malik@panel.fyp.com", "Panel@Adnan"),
      new("Student", "ali.khan@student.fyp.com", "Student@Ali")
    };

    var csvPath = Path.Combine(AppContext.BaseDirectory, "fyp_mock_users.csv");
    if (!File.Exists(csvPath))
    {
      return fallback;
    }

    var byRole = new Dictionary<UserRole, DemoCredential>();
    foreach (var rawLine in File.ReadAllLines(csvPath).Skip(1))
    {
      var line = rawLine.Trim();
      if (string.IsNullOrWhiteSpace(line))
      {
        continue;
      }

      var parts = line.Split(',');
      if (parts.Length < 4)
      {
        continue;
      }

      var email = parts[1].Trim();
      var password = parts[2].Trim();
      var roleText = parts[3].Trim();
      if (!TryMapRole(roleText, out var role) || byRole.ContainsKey(role))
      {
        continue;
      }

      byRole[role] = new DemoCredential(GetRoleLabel(role), email, password);
    }

    var orderedRoles = new[]
    {
      UserRole.Admin,
      UserRole.Coordinator,
      UserRole.HOD,
      UserRole.Supervisor,
      UserRole.Panel,
      UserRole.Student
    };

    var results = orderedRoles
      .Where(byRole.ContainsKey)
      .Select(role => byRole[role])
      .ToList();

    return results.Count == orderedRoles.Length ? results : fallback;
  }

  private static bool TryMapRole(string roleText, out UserRole role)
  {
    switch (roleText.Trim().ToLowerInvariant())
    {
      case "admin":
        role = UserRole.Admin;
        return true;
      case "coordinator":
        role = UserRole.Coordinator;
        return true;
      case "hod":
        role = UserRole.HOD;
        return true;
      case "supervisor":
        role = UserRole.Supervisor;
        return true;
      case "panel":
      case "panel member":
        role = UserRole.Panel;
        return true;
      case "student":
        role = UserRole.Student;
        return true;
      default:
        role = default;
        return false;
    }
  }

  private static string GetRoleLabel(UserRole role) => role switch
  {
    UserRole.HOD => "HOD",
    UserRole.Panel => "Panel",
    _ => role.ToString()
  };

  private sealed record DemoCredential(string Label, string Email, string Password);
}
