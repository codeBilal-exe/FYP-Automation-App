@page "/reset-password-supabase"
@layout MainLayout
@inject NavigationManager Nav

<section class="auth-page compact-auth-page">
  <div class="auth-ambient auth-ambient-one"></div>
  <div class="auth-ambient auth-ambient-two"></div>

  <div class="auth-showcase">
    <div class="auth-kicker"><i class="bi bi-shield-lock"></i> Supabase Recovery</div>
    <h1>Create a new password</h1>
    <p>Use a strong password to complete account recovery.</p>
  </div>

  <div class="auth-card pro-auth-card">
    <div class="auth-logo"><i class="bi bi-lock-fill"></i></div>
    <h2>Set New Password</h2>
    <p class="text-muted mb-4">Minimum 6 characters.</p>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
      <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@_error</div>
    }

    <div id="tokenMissingAlert" class="alert alert-danger py-2 small d-none">
      <i class="bi bi-exclamation-triangle me-1"></i><span id="tokenAlertText">Recovery token missing in URL. Request a new reset link.</span>
    </div>

    <form id="supabaseResetForm" method="post" action="/auth/reset-password-supabase" class="login-form">
      <input type="hidden" id="accessToken" name="accessToken" />

      <div class="mb-3">
        <label class="form-label" for="password">New Password</label>
        <div class="input-icon-wrap">
          <i class="bi bi-lock"></i>
          <input id="password" name="password" type="password" class="form-control" autocomplete="new-password" required minlength="6" />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="confirmPassword">Confirm Password</label>
        <div class="input-icon-wrap">
          <i class="bi bi-lock"></i>
          <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" required minlength="6" />
        </div>
      </div>

      <button class="btn btn-primary w-100 auth-submit" type="submit">
        <span>Update Password</span><i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <div class="mt-3 small">
      <a href="/forgot-password" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Request new reset link</a>
    </div>
  </div>
</section>

<script>
  (function () {
    const hash = window.location.hash.startsWith('#') ? window.location.hash.substring(1) : '';
    const params = new URLSearchParams(hash);
    const accessToken = params.get('access_token');
    const tokenInput = document.getElementById('accessToken');
    const form = document.getElementById('supabaseResetForm');
    const alertBox = document.getElementById('tokenMissingAlert');
    const alertText = document.getElementById('tokenAlertText');
    const errorCode = params.get('error_code');
    const errorDescription = params.get('error_description');

    if (tokenInput && accessToken) {
      tokenInput.value = accessToken;
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, document.title, window.location.pathname + window.location.search);
      }
      return;
    }

    if (form) {
      form.classList.add('d-none');
    }
    if (alertText && errorCode === 'otp_expired') {
      alertText.textContent = 'This reset link has expired or was already used. Request a new reset link and use it immediately.';
    } else if (alertText && errorDescription) {
      alertText.textContent = decodeURIComponent(errorDescription.replace(/\+/g, ' '));
    }
    if (alertBox) {
      alertBox.classList.remove('d-none');
    }
  })();
</script>

@code {
  private string? _error;

  protected override void OnInitialized()
  {
    var query = new Uri(Nav.Uri).Query.TrimStart('?')
      .Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Select(part => part.Split('=', 2))
      .ToDictionary(
        part => Uri.UnescapeDataString(part[0]),
        part => part.Length > 1 ? Uri.UnescapeDataString(part[1]) : ""
      );

    if (query.TryGetValue("status", out var status))
    {
      _error = status switch
      {
        "nomatch" => "Passwords do not match.",
        "missing_token" => "Recovery token is missing. Open the latest reset link from your email.",
        "invalid_token" => "Recovery link is invalid or expired. Request a new one.",
        "invalid_password" => "Password must be at least 6 characters.",
        "update_failed" => "Failed to update password. Request a new reset link and try again.",
        _ => null
      };
    }
  }
}
