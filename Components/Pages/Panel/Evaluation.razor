@page "/panel/evaluation"
@namespace FYP_AutomationSystem.Components.Pages.Panel.Views
@attribute [Authorize(Roles = "Panel")]
@inject AuthenticationStateProvider AuthProvider
@inject EvaluationService EvaluationService

<div class="page-header">
    <div>
        <h1>Viva Evaluation</h1>
        <div class="page-subtitle">Evaluate completed vivas assigned to you.</div>
    </div>
</div>

@if (_isLoading)
{
    <LoadingSpinner Message="Loading assigned vivas..." />
}
else
{
    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger">@_pageError</div>
    }

    @if (!_items.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            No completed vivas assigned to you yet.
        </div>
    }
    else
    {
        @foreach (var item in _items.OrderBy(i => i.ScheduledDate))
        {
            var key = GetRowKey(item);
            var isSaving = _savingRows.Contains(key);
            var marksText = GetDraftMarksText(key);
            var comment = GetDraftComment(key);
            var savedLabel = item.IsEvaluated
                ? $"Saved: {item.ExistingMarks:0.#} marks{(string.IsNullOrWhiteSpace(item.ExistingComment) ? string.Empty : $" - \"{item.ExistingComment}\"")}"
                : null;

            <div class="fcard mb-3">
                <div class="fw-semibold">Group: @item.GroupName</div>
                <div class="text-muted mb-2">Viva: @item.Title - Date: @FormatDate(item.ScheduledDate)</div>
                <hr class="mt-2 mb-3" />

                @if (!item.CanEvaluate)
                {
                    <span class="text-muted">Not assigned</span>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">Marks</label>
                            <input class="form-control"
                                   type="number"
                                   min="0"
                                   max="100"
                                   step="0.5"
                                   value="@marksText"
                                   @oninput="e => UpdateDraftMarks(key, e.Value?.ToString())" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Comment (optional)</label>
                            <textarea class="form-control"
                                      rows="2"
                                      maxlength="500"
                                      @oninput="e => UpdateDraftComment(key, e.Value?.ToString())">@comment</textarea>
                            <div class="small text-muted text-end">@GetCommentLength(key)/500</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-2">
                        <button class="btn btn-primary"
                                disabled="@isSaving"
                                @onclick="() => SaveAsync(item)">
                            @(isSaving ? "Saving..." : (item.IsEvaluated ? "Update" : "Save"))
                        </button>
                    </div>

                    @if (_rowMessages.TryGetValue(key, out var rowMessage) && !string.IsNullOrWhiteSpace(rowMessage))
                    {
                        <div class="alert @(_rowMessageIsError.Contains(key) ? "alert-danger" : "alert-success") mt-2 mb-0">@rowMessage</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(savedLabel))
                    {
                        <div class="text-success mt-2">Saved: @savedLabel</div>
                    }
                }
            </div>
        }
    }
}

@code {
    private bool _isLoading = true;
    private string? _pageError;
    private int _panelMemberId;
    private List<EvaluationItemDto> _items = new();
    private readonly Dictionary<int, decimal?> _draftMarks = new();
    private readonly Dictionary<int, string> _draftComments = new();
    private readonly Dictionary<int, string> _rowMessages = new();
    private readonly HashSet<int> _rowMessageIsError = new();
    private readonly HashSet<int> _savingRows = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _pageError = null;

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var idValue = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(idValue, out _panelMemberId))
            {
                _pageError = "Unable to resolve current user.";
                _items = new List<EvaluationItemDto>();
                _isLoading = false;
                StateHasChanged();
                return;
            }

            _items = await EvaluationService.GetPanelEvaluationItemsAsync(_panelMemberId);
            _draftMarks.Clear();
            _draftComments.Clear();
            _rowMessages.Clear();
            _rowMessageIsError.Clear();
            _savingRows.Clear();

            foreach (var item in _items)
            {
                var key = GetRowKey(item);
                _draftMarks[key] = item.ExistingMarks;
                _draftComments[key] = item.ExistingComment ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            _pageError = $"Failed to load assigned vivas: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateDraftMarks(int rowKey, string? value)
    {
        if (decimal.TryParse(value, out var parsed))
        {
            _draftMarks[rowKey] = parsed;
            return;
        }

        _draftMarks[rowKey] = null;
    }

    private void UpdateDraftComment(int rowKey, string? value)
    {
        _draftComments[rowKey] = value ?? string.Empty;
    }

    private string GetDraftMarksText(int rowKey)
    {
        return _draftMarks.TryGetValue(rowKey, out var marks) && marks.HasValue
            ? marks.Value.ToString("0.##")
            : string.Empty;
    }

    private string GetDraftComment(int rowKey)
    {
        return _draftComments.TryGetValue(rowKey, out var comment) ? comment : string.Empty;
    }

    private int GetCommentLength(int rowKey)
    {
        return GetDraftComment(rowKey).Length;
    }

    private async Task SaveAsync(EvaluationItemDto item)
    {
        var key = GetRowKey(item);
        _rowMessages[key] = string.Empty;
        _rowMessageIsError.Remove(key);
        _savingRows.Add(key);
        StateHasChanged();

        try
        {
            if (!_draftMarks.TryGetValue(key, out var marks) || !marks.HasValue)
            {
                _rowMessages[key] = "Please enter marks before saving.";
                _rowMessageIsError.Add(key);
                return;
            }

            if (marks.Value < 0 || marks.Value > 100)
            {
                _rowMessages[key] = "Marks must be between 0 and 100.";
                _rowMessageIsError.Add(key);
                return;
            }

            var comment = GetDraftComment(key);
            if (comment.Length > 500)
            {
                _rowMessages[key] = "Comment cannot exceed 500 characters.";
                _rowMessageIsError.Add(key);
                return;
            }

            var result = await EvaluationService.SaveEvaluationAsync(
                _panelMemberId,
                "Panel Member",
                item.Id,
                item.Type,
                marks.Value,
                string.IsNullOrWhiteSpace(comment) ? null : comment,
                item.GroupId);

            if (!result.Success)
            {
                _rowMessages[key] = result.ErrorMessage ?? "Unable to save evaluation.";
                _rowMessageIsError.Add(key);
                return;
            }

            item.ExistingMarks = marks.Value;
            item.ExistingComment = string.IsNullOrWhiteSpace(comment) ? null : comment;
            _rowMessages[key] = "Saved successfully.";
        }
        catch (Exception ex)
        {
            _rowMessages[key] = $"Failed to save: {ex.Message}";
            _rowMessageIsError.Add(key);
        }
        finally
        {
            _savingRows.Remove(key);
            StateHasChanged();
        }
    }

    private static int GetRowKey(EvaluationItemDto item)
    {
        return 2_000_000 + item.Id;
    }

    private static string FormatDate(DateTime? date)
    {
        return date.HasValue ? date.Value.ToString("dd MMM yyyy") : "N/A";
    }
}
