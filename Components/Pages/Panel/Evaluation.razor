@page "/panel/evaluation"
@namespace FYP_AutomationSystem.Components.Pages.Panel.Views
@attribute [Authorize(Roles = "Panel")]
@inject AuthenticationStateProvider AuthProvider
@inject EvaluationService EvaluationService

<div class="page-header">
    <div>
        <h1>Panel <em>Remarks</em></h1>
        <div class="page-subtitle">Submit qualitative remarks for vivas, presentations, and evaluations you're assigned to. Marks are entered by the supervisor.</div>
    </div>
</div>

@if (_isLoading)
{
    <LoadingSpinner Message="Loading assigned vivas..." />
}
else
{
    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger">@_pageError</div>
    }

    @if (!_items.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            No vivas, presentations, or evaluations are currently assigned to you.
        </div>
    }
    else
    {
        @foreach (var item in _items.OrderBy(i => i.ScheduledDate))
        {
            var key = item.Id;
            var isSaving = _savingRows.Contains(key);
            var draft = GetDraft(key);
            var otherRemarks = (_remarksByViva.TryGetValue(item.Id, out var list) ? list : new List<PanelRemarkDto>())
                .Where(r => r.PanelMemberId != _panelMemberId)
                .ToList();

            <div class="fcard mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <div class="fw-semibold">@item.GroupName</div>
                        <div class="text-muted small">@item.Title · @FormatDate(item.ScheduledDate)</div>
                    </div>
                    <span class="fbadge @(item.Status.ToLowerInvariant())">@item.Status</span>
                </div>
                <hr class="mt-2 mb-3" />

                <div class="mb-2">
                    <label class="form-label">Your remarks</label>
                    <textarea class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Concise qualitative remarks visible to the student, supervisor, and other panel members."
                              @oninput="e => UpdateDraft(key, e.Value?.ToString())">@draft</textarea>
                    <div class="small text-muted text-end">@draft.Length/1000</div>
                </div>

                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary"
                            disabled="@isSaving"
                            @onclick="() => SaveAsync(item)">
                        @(isSaving ? "Saving..." : (item.IsRemarked ? "Update remarks" : "Save remarks"))
                    </button>
                </div>

                @if (_rowMessages.TryGetValue(key, out var rowMessage) && !string.IsNullOrWhiteSpace(rowMessage))
                {
                    <div class="alert @(_rowMessageIsError.Contains(key) ? "alert-danger" : "alert-success") mt-2 mb-0">@rowMessage</div>
                }

                @if (otherRemarks.Any())
                {
                    <div class="panel-remarks-other mt-3">
                        <div class="panel-remarks-title">Other panel members</div>
                        @foreach (var r in otherRemarks)
                        {
                            <div class="panel-remark-row">
                                <div class="panel-remark-who">
                                    <strong>@r.PanelMemberName</strong>
                                    <span class="text-muted small ms-2">@r.SavedAt.ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                                <div class="panel-remark-text">@r.Remarks</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
}

@code {
    private bool _isLoading = true;
    private string? _pageError;
    private int _panelMemberId;
    private List<PanelEvalItem> _items = new();
    private Dictionary<int, List<PanelRemarkDto>> _remarksByViva = new();
    private readonly Dictionary<int, string> _drafts = new();
    private readonly Dictionary<int, string> _rowMessages = new();
    private readonly HashSet<int> _rowMessageIsError = new();
    private readonly HashSet<int> _savingRows = new();

    private sealed class PanelEvalItem
    {
        public int Id { get; init; }
        public int GroupId { get; init; }
        public string GroupName { get; init; } = string.Empty;
        public string Title { get; init; } = string.Empty;
        public DateTime? ScheduledDate { get; init; }
        public string Status { get; init; } = string.Empty;
        public string? ExistingRemark { get; set; }
        public bool IsRemarked => !string.IsNullOrWhiteSpace(ExistingRemark);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _pageError = null;

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var idValue = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (!int.TryParse(idValue, out _panelMemberId))
            {
                _pageError = "Unable to resolve current user.";
                _items = new();
                _isLoading = false;
                StateHasChanged();
                return;
            }

            var dtos = await EvaluationService.GetPanelEvaluationItemsAsync(_panelMemberId);
            _items = dtos.Select(d => new PanelEvalItem
            {
                Id = d.Id,
                GroupId = d.GroupId,
                GroupName = d.GroupName,
                Title = d.Title,
                ScheduledDate = d.ScheduledDate,
                Status = d.Status,
                ExistingRemark = d.ExistingComment
            }).ToList();

            _drafts.Clear();
            foreach (var i in _items)
            {
                _drafts[i.Id] = i.ExistingRemark ?? string.Empty;
            }

            _remarksByViva = await EvaluationService.GetPanelRemarksForVivasAsync(_items.Select(i => i.Id));
        }
        catch (Exception ex)
        {
            _pageError = $"Failed to load assigned vivas: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string GetDraft(int id) => _drafts.TryGetValue(id, out var v) ? v : string.Empty;
    private void UpdateDraft(int id, string? v) => _drafts[id] = v ?? string.Empty;

    private async Task SaveAsync(PanelEvalItem item)
    {
        _rowMessages[item.Id] = string.Empty;
        _rowMessageIsError.Remove(item.Id);
        _savingRows.Add(item.Id);
        StateHasChanged();

        try
        {
            var draft = GetDraft(item.Id);
            var result = await EvaluationService.SavePanelRemarkAsync(_panelMemberId, item.Id, draft);

            if (!result.Success)
            {
                _rowMessages[item.Id] = result.ErrorMessage ?? "Unable to save remarks.";
                _rowMessageIsError.Add(item.Id);
                return;
            }

            item.ExistingRemark = draft.Trim();
            _rowMessages[item.Id] = "Saved successfully.";

            // Refresh the cross-member remark list so the new entry shows up.
            _remarksByViva = await EvaluationService.GetPanelRemarksForVivasAsync(_items.Select(i => i.Id));
        }
        catch (Exception ex)
        {
            _rowMessages[item.Id] = $"Failed to save: {ex.Message}";
            _rowMessageIsError.Add(item.Id);
        }
        finally
        {
            _savingRows.Remove(item.Id);
            StateHasChanged();
        }
    }

    private static string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("dd MMM yyyy") : "N/A";
}

<style>
  .panel-remarks-other {
    margin-top: 1rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: .8rem 1rem;
  }
  .panel-remarks-title {
    font-size: .68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--muted);
    margin-bottom: .55rem;
  }
  .panel-remark-row {
    padding: .55rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .panel-remark-row:last-child { border-bottom: 0; }
  .panel-remark-who { display: flex; align-items: center; gap: .25rem; }
  .panel-remark-text { color: var(--ink-2); font-size: .9rem; margin-top: .2rem; line-height: 1.45; }
</style>
