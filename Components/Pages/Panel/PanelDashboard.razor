@page "/panel/dashboard"
@attribute [Authorize(Roles = "Panel")]
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider
@inject VivaService VivaService
@using Microsoft.EntityFrameworkCore

<div class="page-header">
  <div><h1>Panel Dashboard</h1><div class="page-subtitle">Welcome back, @_panelName.</div></div>
  <button class="btn btn-soft" @onclick="Refresh" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
</div>

@if (_loading)
{
  <LoadingSpinner Message="Loading dashboard…" />
}
else
{
  <div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6"><StatCard Icon="bi-calendar-check" Label="Upcoming Sessions" Value="@_upcomingSlots" /></div>
    <div class="col-md-4 col-sm-6"><StatCard Icon="bi-check-circle" IconClass="success" Label="Completed" Value="@_completedSlots" /></div>
    <div class="col-md-4 col-sm-6"><StatCard Icon="bi-star" IconClass="warning" Label="Evaluations" Value="@_evaluations" /></div>
  </div>

  <!-- Profile Info Card -->
  <div class="fcard mb-3">
    <div class="fcard-title"><i class="bi bi-person-circle"></i> My Profile</div>
    <div class="row g-3">
      <div class="col-md-6">
        <div class="mb-2"><strong>Name:</strong> @_panelName</div>
        <div class="mb-2"><strong>Email:</strong> @_panelEmail</div>
      </div>
      <div class="col-md-6">
        <div class="mb-2"><strong>Expertise:</strong> @(_expertise ?? "Not specified")</div>
        <div class="mb-2"><strong>Role:</strong> <span class="badge bg-primary">Panel Member</span></div>
      </div>
    </div>
  </div>

  <!-- Upcoming Sessions Preview -->
  @if (_nextSlots.Count > 0)
  {
    <div class="fcard">
      <div class="fcard-title"><i class="bi bi-calendar-event"></i> Upcoming Sessions</div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Date</th><th>Time</th><th>Type</th><th>Group</th><th>Venue</th></tr></thead>
          <tbody>
            @foreach (var s in _nextSlots)
            {
              <tr>
                <td>@s.ScheduledAt.ToString("dd MMM yyyy")</td>
                <td>@s.StartTime.ToString(@"hh\:mm") – @s.EndTime.ToString(@"hh\:mm")</td>
                <td><span class="badge bg-info">@s.SlotType</span></td>
                <td>@(s.Group?.GroupName ?? "—")</td>
                <td>@s.Venue</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }
  else
  {
    <div class="fcard text-muted text-center py-4"><i class="bi bi-calendar-x fs-1 d-block mb-2"></i> No upcoming sessions scheduled.</div>
  }
}

@code {
  private bool _loading = true;
  private string _panelName = "", _panelEmail = "";
  private string? _expertise;
  private int _panelId;
  private int _upcomingSlots, _completedSlots, _evaluations;
  private List<VivaSlot> _nextSlots = new();

  protected override async Task OnInitializedAsync() => await Refresh();

  private async Task Refresh()
  {
    _loading = true;
    var auth = await AuthProvider.GetAuthenticationStateAsync();
    var idStr = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    if (!int.TryParse(idStr, out _panelId)) return;

    var user = await Db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == _panelId);
    if (user == null) return;

    _panelName = user.FullName;
    _panelEmail = user.Email;
    _expertise = user.Expertise;

    var allSlots = await VivaService.GetVivaSlotsForPanelMember(_panelId);
    _upcomingSlots = allSlots.Count(s => s.ScheduledAt > DateTime.UtcNow && s.Status == VivaStatus.Scheduled);
    _completedSlots = allSlots.Count(s => s.Status == VivaStatus.Completed);
    _evaluations = await Db.Evaluations.AsNoTracking().CountAsync(e => e.EvaluatorId == _panelId);

    _nextSlots = allSlots
        .Where(s => s.ScheduledAt > DateTime.UtcNow && s.Status == VivaStatus.Scheduled)
        .OrderBy(s => s.ScheduledAt)
        .Take(5)
        .ToList();

    _loading = false;
  }
}
