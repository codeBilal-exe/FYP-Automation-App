@page "/reset-password"
@layout MainLayout
@inject NavigationManager Nav

<section class="auth-page">
  <button type="button" class="theme-toggle auth-theme-toggle" data-action="toggle-theme"
          title="Toggle theme" aria-label="Toggle light or dark theme">
    <i class="ti ti-sun bi bi-sun"></i>
    <i class="ti ti-moon bi bi-moon-stars"></i>
  </button>
  <div class="auth-corner-mark">Account · Secure reset</div>

  <div class="auth-card pro-auth-card" role="main" aria-labelledby="reset-heading">
    <div class="auth-eyebrow">Set new password</div>

    <div class="auth-logo" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></div>

    <h2 id="reset-heading">Choose a <em>new</em> password.</h2>
    <p class="text-muted">Minimum 6 characters. You'll be returned to sign in after this step.</p>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
      <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1"></i>@_error</div>
    }

    @if (_hasToken)
    {
      <form method="post" action="/auth/reset-password" class="login-form">
        <input type="hidden" name="token" value="@_token" />

        <div class="mb-3">
          <label class="form-label" for="password">New password</label>
          <div class="input-icon-wrap">
            <i class="bi bi-lock field-leading-icon" aria-hidden="true"></i>
            <input id="password" name="password" type="password" class="form-control"
                   autocomplete="new-password" required minlength="6" placeholder="••••••••" />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="confirmPassword">Confirm password</label>
          <div class="input-icon-wrap">
            <i class="bi bi-lock-fill field-leading-icon" aria-hidden="true"></i>
            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control"
                   autocomplete="new-password" required minlength="6" placeholder="••••••••" />
          </div>
        </div>

        <button class="btn btn-primary w-100 auth-submit" type="submit">
          <span>Update password</span><i class="bi bi-arrow-right"></i>
        </button>
      </form>
    }
    else
    {
      <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>Reset token missing. Request a new reset link.
      </div>
    }

    <div class="auth-foot">
      <a href="/forgot-password"><i class="bi bi-arrow-left me-1"></i>Request new reset link</a>
    </div>
  </div>
</section>

@code {
  private string _token = string.Empty;
  private bool _hasToken;
  private string? _error;

  protected override void OnInitialized()
  {
    var query = new Uri(Nav.Uri).Query.TrimStart('?')
      .Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Select(part => part.Split('=', 2))
      .ToDictionary(
        part => Uri.UnescapeDataString(part[0]),
        part => part.Length > 1 ? Uri.UnescapeDataString(part[1]) : ""
      );

    if (query.TryGetValue("token", out var token))
    {
      _token = token;
      _hasToken = !string.IsNullOrWhiteSpace(_token);
    }

    if (query.TryGetValue("status", out var status))
    {
      _error = status switch
      {
        "nomatch" => "Passwords do not match.",
        "invalid" => "Invalid or expired reset link. Request a new one.",
        _ => null
      };
    }
  }
}
