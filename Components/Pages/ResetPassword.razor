@page "/reset-password"
@layout MainLayout
@inject NavigationManager Nav

<section class="auth-page compact-auth-page">
  <div class="auth-ambient auth-ambient-one"></div>
  <div class="auth-ambient auth-ambient-two"></div>

  <div class="auth-showcase">
    <div class="auth-kicker"><i class="bi bi-shield-lock"></i> Secure Reset</div>
    <h1>Create a new password</h1>
    <p>Choose a strong password and sign in again.</p>
  </div>

  <div class="auth-card pro-auth-card">
    <div class="auth-logo"><i class="bi bi-lock-fill"></i></div>
    <h2>Set New Password</h2>
    <p class="text-muted mb-4">Minimum 6 characters.</p>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
      <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@_error</div>
    }

    @if (_hasToken)
    {
      <form method="post" action="/auth/reset-password" class="login-form">
        <input type="hidden" name="token" value="@_token" />

        <div class="mb-3">
          <label class="form-label" for="password">New Password</label>
          <div class="input-icon-wrap">
            <i class="bi bi-lock"></i>
            <input id="password" name="password" type="password" class="form-control" autocomplete="new-password" required minlength="6" />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label" for="confirmPassword">Confirm Password</label>
          <div class="input-icon-wrap">
            <i class="bi bi-lock"></i>
            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" required minlength="6" />
          </div>
        </div>

        <button class="btn btn-primary w-100 auth-submit" type="submit">
          <span>Update Password</span><i class="bi bi-arrow-right"></i>
        </button>
      </form>
    }
    else
    {
      <div class="small text-muted">Reset token missing. Request a new reset link.</div>
    }

    <div class="mt-3 small">
      <a href="/forgot-password" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Request new reset link</a>
    </div>
  </div>
</section>

@code {
  private string _token = string.Empty;
  private bool _hasToken;
  private string? _error;

  protected override void OnInitialized()
  {
    var query = new Uri(Nav.Uri).Query.TrimStart('?')
      .Split('&', StringSplitOptions.RemoveEmptyEntries)
      .Select(part => part.Split('=', 2))
      .ToDictionary(
        part => Uri.UnescapeDataString(part[0]),
        part => part.Length > 1 ? Uri.UnescapeDataString(part[1]) : ""
      );

    if (query.TryGetValue("token", out var token))
    {
      _token = token;
      _hasToken = !string.IsNullOrWhiteSpace(_token);
    }

    if (query.TryGetValue("status", out var status))
    {
      _error = status switch
      {
        "nomatch" => "Passwords do not match.",
        "invalid" => "Invalid or expired reset link. Request a new one.",
        _ => null
      };
    }
  }
}
