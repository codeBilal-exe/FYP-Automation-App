@page "/not-found"
<section class="auth-page">
  <div class="auth-corner-mark">Status · 404</div>
  <div class="auth-card pro-auth-card text-center">
    <div class="auth-eyebrow" style="justify-content:center">Page not found</div>
    <div class="auth-logo mx-auto" aria-hidden="true"><i class="bi bi-compass"></i></div>
    <h2>404 — <em>off course.</em></h2>
    <p class="text-muted">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="btn btn-primary auth-submit" style="display:inline-flex;margin-top:.4rem">
      <span>Return home</span><i class="bi bi-arrow-right"></i>
    </a>
  </div>
</section>
