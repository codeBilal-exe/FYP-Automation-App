@if (Visible)
{
  <div class="modal-backdrop-c" @onclick="Cancel">
    <div class="modal-card" @onclick:stopPropagation>
      <h5 class="mb-2">@Title</h5>
      <p class="text-muted">@Message</p>
      <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-light" @onclick="Cancel">Cancel</button>
        <button class="btn btn-primary" @onclick="Confirm">@ConfirmText</button>
      </div>
    </div>
  </div>
}
@code {
  [Parameter] public bool Visible { get; set; }
  [Parameter] public string Title { get; set; } = "Confirm";
  [Parameter] public string Message { get; set; } = "Are you sure?";
  [Parameter] public string ConfirmText { get; set; } = "Yes";
  [Parameter] public EventCallback OnConfirm { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }
  private async Task Confirm() => await OnConfirm.InvokeAsync();
  private async Task Cancel() => await OnCancel.InvokeAsync();
}
